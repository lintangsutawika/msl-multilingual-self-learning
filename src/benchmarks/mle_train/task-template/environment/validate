#!/usr/bin/env bash
# validate <file.csv>: score a submission on the PUBLIC leaderboard (a fixed ~30% of the test ids) and log it.
set -uo pipefail
[ $# -eq 1 ] || { echo "usage: validate <submission.csv>"; exit 2; }
OUT=$(python3 /opt/grader/grade_cli.py --grader-dir /opt/grader --answers /opt/grader/public_answers.csv \
      --submission "$1" --id-column '{id_column}' 2>&1)
mkdir -p /logs/verifier
python3 - "$1" "$OUT" <<'PY'
import json, sys
path = sys.argv[1]
try:
    r = json.loads(sys.argv[2].strip().splitlines()[-1])
except Exception:
    r = {"valid": False, "score": None, "higher_is_better": None, "error": "grader crashed: " + sys.argv[2][-300:]}
with open("/logs/verifier/validation_scores.jsonl", "a") as f:
    f.write(json.dumps({"submission_path": path, "submission_score": r["score"], "valid": r["valid"],
                        "higher_is_better": r["higher_is_better"], "error": r["error"]}) + "\n")
d = "higher is better" if r["higher_is_better"] else "lower is better"
if r["valid"]:
    print(f"score={r['score']:.6g} (public leaderboard, {d})")
else:
    print(f"score=None invalid submission: {r['error']}")
    sys.exit(1)
PY
