Bootstrap: docker
From: ubuntu:24.04

%post
    apt-get update

    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        python3 \
        nodejs \
        npm \
        ca-certificates

    npm install -g typescript

    rm -rf /var/lib/apt/lists/*

%test
    python3 --version
    node --version
    npm --version
    tsc --version
