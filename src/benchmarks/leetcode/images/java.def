Bootstrap: docker
From: ubuntu:24.04

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        python3 \
        default-jdk \
        libgoogle-gson-java \
        ca-certificates
    rm -rf /var/lib/apt/lists/*

%test
    python3 --version
    javac -version
    test -f /usr/share/java/gson.jar
