Bootstrap: docker
From: ubuntu:24.04

%post
    apt-get update

    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        python3 \
        rustc \
        cargo \
        librust-serde-dev \
        librust-serde-json-dev \
        ca-certificates

    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/usr/bin:$PATH

%test
    python3 --version
    rustc --version
    cargo --version
    test -d /usr/share/cargo/registry
