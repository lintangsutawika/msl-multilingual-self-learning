# Site settings for the Babel scripts (run_babel.sh, slurm/*.sbatch, oracle_check.sh). Copy to site.env (git-ignored)
# and set the paths. A variable already set in the environment wins over the value here.
: "${GRADER_PY:=/path/to/mlebench-grader-venv/bin/python}"  # made by setup_grader_venv.sh
: "${VLLM_CUDA_SIF:=/path/to/vllm-openai.sif}"               # agent sweeps only: vLLM image (scripts/serve/serve_vllm.sh)
: "${CACHE_DIR:=/path/to/cache}"                             # agent sweeps only: host cache for vLLM (Hugging Face models)
export GRADER_PY VLLM_CUDA_SIF CACHE_DIR
