#!/bin/sh
# Root-only grader entry point, reached from `validate` through one sudo rule.
# Isolated interpreter: no PYTHONPATH, no user site-packages, no cwd on sys.path,
# and HOME=/root so mlebench finds the answers startup.sh placed under /root.
HOME=/root
export HOME
exec /usr/local/bin/python3 -I /opt/msl/validate.py "$@"
